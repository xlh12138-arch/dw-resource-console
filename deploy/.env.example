# Copy this file to the repository root as .env before starting Compose.
IMAGE_PREFIX=dw-resource-console
IMAGE_TAG=1.0.0
DOCKER_SUBNET=172.28.0.0/24

NODE_ENV=production
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=8787
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://server-ip:8080
TRUST_PROXY=true

# Use the intranet PostgreSQL address. If PostgreSQL runs on the Docker host,
# keep host.docker.internal and allow the Compose subnet in pg_hba.conf.
DB_DRIVER=postgres
DATABASE_URL=postgres://dw_console:change-me@host.docker.internal:5432/dw_console
# Optional override for Docker when DATABASE_URL itself must remain a host-local address.
# DOCKER_DATABASE_URL=postgres://dw_console:change-me@host.docker.internal:5432/dw_console
DB_SCHEMA=dw_console
DB_CREATE_SCHEMA=true
DB_SSL=false
DB_POOL_MAX=10

JWT_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

# Deployment switches handled by the one-shot db-init container.
# Existing tables + existing data: both false.
# Empty schema: DB_CREATE_TABLES=true.
# Import a prepared data file: DB_IMPORT_DATA=true and copy the file to ./import.
DB_CREATE_TABLES=false
DB_IMPORT_DATA=false
DB_IMPORT_FILE=/import/data.sql
DB_IMPORT_FORMAT=auto
DB_IMPORT_SOURCE_SCHEMA=public
DB_IMPORT_FORCE=false

# Keep false for Docker deployment; db-init performs schema-aware migrations.
AUTO_MIGRATE=false

WEB_PORT=8080
VITE_API_BASE_URL=
