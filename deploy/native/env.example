NODE_ENV=production
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=8787
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://<kylin-server-ip>:8080
# 部署同一台机器上的 Nginx 时填 127.0.0.1 或 ::1（多个用英文逗号分隔）；
# Nginx 必须转发 X-Forwarded-Proto，刷新 Cookie 才按实际协议决定是否加 Secure。
TRUST_PROXY=127.0.0.1

DB_DRIVER=postgres
DB_COMPAT_MODE=dws
DATABASE_URL=postgres://user:url-encoded-password@dws-host:5432/database
DB_SCHEMA=dw_console
DB_CREATE_SCHEMA=false
DB_SSL=false
DB_POOL_MAX=10
AUTO_MIGRATE=false

JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
IDLE_TIMEOUT=30m

RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

VITE_API_BASE_URL=
