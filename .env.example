# ---------- 运行环境 ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- API 服务 ----------
API_HOST=0.0.0.0
API_PORT=8787
API_BASE_PATH=/api/v1
# 生产环境务必改为显式前端域名，多个用英文逗号分隔，禁止使用 *
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 默认不信任代理头；部署在可信反向代理后时填写代理 IP/CIDR，多个用英文逗号分隔
TRUST_PROXY=false

# ---------- 数据库 ----------
# 示例为 SQLite（零运维，开箱即用）；切换 PostgreSQL 只需改 DRIVER 与 DATABASE_URL
DB_DRIVER=sqlite
DATABASE_URL=./data/dw-console.db
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dw_console
# DB_SSL=false
# DB_POOL_MAX=10

# ---------- 认证 ----------
# 生产环境请使用 openssl rand -hex 48 生成
JWT_SECRET=dev-only-secret-please-change-me-to-a-random-64-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# 首次启动时自动创建的管理员账号
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# ---------- 限流 ----------
# 单 IP 每分钟请求上限；生产建议 300 以内
RATE_LIMIT_MAX=300
# 登录接口单独限流（抵御口令爆破）
RATE_LIMIT_LOGIN_MAX=10

# ---------- 前端 ----------
WEB_PORT=5173
# 留空 = 走 Vite 同源代理（推荐）；填写 http://localhost:8787 则前端直连后端（已配置 CORS）
VITE_API_BASE_URL=
